# Every variable here is optional: the site runs without any of them, and the
# feature it gates simply stays off. Copy to `.env.local` and fill in what you
# need. Never commit `.env.local`.

NEXT_PUBLIC_APP_URL=https://acme.com

# Set by Vercel on every deployment and read by the footer title block.
# Locally they are unset, so the BUILD field reads "unavailable" — fill them in
# to preview how a deployment renders. VERCEL_ENV: production | preview
VERCEL_ENV=
VERCEL_GIT_COMMIT_SHA=

# Repo star count in the header. Without it the request is anonymous and rate
# limited, but it still works. No scopes needed.
# https://github.com/settings/tokens
GITHUB_API_TOKEN=

# Contribution heatmap on the home page. Any endpoint shaped
# `{ contributions: [{ date, count, level }] }` works.
# https://github.com/grubersjoe/github-contributions-api
NEXT_PUBLIC_GITHUB_CONTRIBUTIONS_API_URL=https://github-contributions-api.jogruber.de/v4

# https://dashboard.openpanel.dev
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_PROJECT_ID=
OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=

# https://tagmanager.google.com
NEXT_PUBLIC_GTM_ID=GTM-XYZ

# Discord channel that receives "Was this helpful?" notes from doc pages.
# Channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
# Unset locally: notes are logged to the dev server console instead.
DISCORD_FEEDBACK_WEBHOOK_URL=

# Carbon Ads zone (sell.buysellads.com > Zones > Get Ad Tags). Leave both
# empty to run the site without ads: the CarbonAds component renders nothing.
NEXT_PUBLIC_CARBON_ADS_SERVE=
NEXT_PUBLIC_CARBON_ADS_PLACEMENT=
